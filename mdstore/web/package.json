    "@svar-ui/svelte-kanban": "^2.6.0",
    "@sveltejs/kit": "2.70.3",
    "dompurify": "3.4.15",
    "markdown-it": "15.0.2",
    "node-diff3": "^3.2.1",
    "svelte": "5.57.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.2",
